            <button onclick="setSubscriptionTier('CLINIC')" id="tier-btn-CLINIC" class="rounded-full px-4 py-1.5 text-xs font-semibold border border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-100 transition">
