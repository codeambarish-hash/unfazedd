<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>UNFAZED — Therapist Practice Management SaaS Platform</title>
  <!-- Load Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Load Google Font Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <!-- Load Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #ffffff;
      color: #171717;
    }
    .font-mono-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.04em;
    }
    .rich-editor {
      min-height: 150px;
      outline: none;
    }
    .rich-editor p {
      margin-bottom: 0.5rem;
    }
    .rich-editor ul {
      list-style-type: disc;
      padding-left: 1.25rem;
      margin-bottom: 0.5rem;
    }
    /* Custom scrollbar for chat and tables */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-white text-neutral-900 min-h-screen flex flex-col selection:bg-neutral-900 selection:text-amber-300">

  <!-- ===================================================================== -->
  <!-- TOP GLOBAL NAVIGATION (KAGGLE-INSPIRED MINIMALIST WHITE HEADER)       -->
  <!-- ===================================================================== -->
  <header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-3.5 sm:px-8">
      <!-- Left: Brand Wordmark + Horizontal Navigation Links -->
      <div class="flex flex-wrap items-center gap-6 lg:gap-8">
        <div class="flex items-center gap-2 cursor-pointer" onclick="switchMainView('landing')">
          <span class="text-2xl font-bold tracking-tighter text-neutral-900">unfazed</span>
          <span class="rounded-full bg-amber-100 border border-amber-300 px-2 py-0.5 text-[10px] font-mono-eyebrow font-semibold text-amber-900">
            Practice OS
          </span>
        </div>

        <nav class="flex flex-wrap items-center gap-1 sm:gap-2">
          <button onclick="switchMainView('landing')" id="nav-btn-landing" class="rounded-full px-3.5 py-1.5 text-xs sm:text-sm font-medium transition bg-neutral-900 text-white">
            <span>Overview</span>
          </button>
          <button onclick="switchMainView('public')" id="nav-btn-public" class="rounded-full px-3.5 py-1.5 text-xs sm:text-sm font-medium transition text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100">
            <span id="nav-slug-label">Branded Link (/dr-sharma)</span>
          </button>
          <button onclick="switchMainView('therapist')" id="nav-btn-therapist" class="rounded-full px-3.5 py-1.5 text-xs sm:text-sm font-medium transition text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100">
            <span>Therapist Dashboard</span>
          </button>
          <button onclick="switchMainView('client')" id="nav-btn-client" class="rounded-full px-3.5 py-1.5 text-xs sm:text-sm font-medium transition text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100">
            <span>Client Portal</span>
          </button>
          <button onclick="switchMainView('therapist'); switchTherapistTab('subscription')" class="hidden md:inline-flex items-center gap-1 rounded-full px-3 py-1.5 text-xs sm:text-sm font-medium text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100">
            <span>Plan Admin</span>
            <i data-lucide="chevron-down" class="h-3.5 w-3.5"></i>
          </button>
        </nav>
      </div>

      <!-- Right: Circular Search Icon, Reset Demo Link & Dark Pill CTA -->
      <div class="flex items-center gap-3">
        <button
          onclick="switchMainView('therapist'); switchTherapistTab('clients'); setTimeout(() => document.getElementById('crm-search')?.focus(), 100);"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-neutral-300 text-neutral-700 hover:bg-neutral-100 transition"
          title="Search Clients CRM"
        >
          <i data-lucide="search" class="h-4 w-4"></i>
        </button>
        <button
          onclick="resetToDefaultDemo()"
          class="px-2.5 py-1.5 text-xs sm:text-sm font-medium text-neutral-600 hover:text-neutral-900 transition"
          title="Reset saved changes to default demo state"
        >
          Reset Demo
        </button>
        <button
          onclick="switchMainView('therapist')"
          class="rounded-full bg-neutral-900 px-5 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-neutral-800 transition"
        >
          Practice Console
        </button>
      </div>
    </div>
  </header>

  <!-- Global Non-Blocking Toast Notification Box -->
  <div id="toast-box" class="fixed bottom-5 right-5 z-50 hidden max-w-md rounded-2xl border border-neutral-800 bg-neutral-900 px-5 py-4 text-xs font-semibold text-white shadow-2xl transition-all">
    <div class="flex items-start gap-3">
      <div class="mt-0.5 rounded-lg bg-amber-400/20 p-1.5 text-amber-300">
        <i data-lucide="bell-ring" class="h-4 w-4"></i>
      </div>
      <div class="flex-1">
        <p id="toast-title" class="font-mono-eyebrow font-bold text-amber-300 uppercase tracking-wider text-[10px]">System Event</p>
        <p id="toast-message" class="mt-0.5 text-neutral-100 leading-relaxed"></p>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- VIEW 1: LANDING PAGE (KAGGLE FRONTIER HERO & GOLDEN MOUNTAIN BANNER)  -->
  <!-- ===================================================================== -->
  <main id="view-landing" class="flex-1 space-y-16 pb-16">
    <!-- Kaggle-Style White Top Hero + Golden Mountain Graphic -->
    <section class="relative overflow-hidden bg-white pt-12 sm:pt-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 text-center space-y-5">
        <p class="font-mono-eyebrow text-xs sm:text-sm text-neutral-600">
          Unfazed is for Clinical Practitioners
        </p>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-neutral-900 leading-[1.12]">
          Evaluating what works at therapy’s frontier
        </h1>
        <p class="mx-auto max-w-2xl text-base sm:text-lg text-neutral-500 font-normal leading-relaxed">
          Unified appointment scheduling, zero-leak SOAP/DAP clinical notes, and Razorpay session packages where therapists shape real-world progress from one link:
          <code onclick="switchMainView('public')" class="cursor-pointer rounded-md bg-neutral-100 px-2 py-0.5 font-mono-eyebrow text-sm text-neutral-900 border border-neutral-300 hover:bg-amber-50">unfazed.in/dr-sharma</code>
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 pt-3">
          <button onclick="switchMainView('therapist')" class="inline-flex items-center gap-2 rounded-full bg-neutral-900 px-6 py-3 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-neutral-800 transition">
            <span>Open Therapist Dashboard</span>
            <i data-lucide="arrow-right" class="h-4 w-4"></i>
          </button>
          <button onclick="switchMainView('public')" class="inline-flex items-center gap-2 rounded-full border border-neutral-300 bg-white px-6 py-3 text-xs sm:text-sm font-semibold text-neutral-800 hover:bg-neutral-50 transition">
            <span>Test Branded Link (/dr-sharma)</span>
          </button>
          <button onclick="switchMainView('client')" class="inline-flex items-center gap-2 rounded-full border border-neutral-300 bg-white px-6 py-3 text-xs sm:text-sm font-semibold text-neutral-800 hover:bg-neutral-50 transition">
            <span>Open Client Portal</span>
          </button>
        </div>
      </div>

      <!-- Illustrated Golden Mountain Peak Banner with Vector Trajectory Lines & Floating Benchmark Cards -->
      <div class="relative mt-12 w-full overflow-hidden border-y border-neutral-200" style="background: linear-gradient(90deg, #b8ab96 0%, #c8bca7 35%, #d8c383 70%, #f5b400 100%); min-height: 330px;">
        <!-- Mountain & Trajectory Vectors SVG -->
        <svg viewBox="0 0 1440 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-[330px] sm:h-[360px] object-cover block">
          <!-- Warm golden glow on right -->
          <defs>
            <linearGradient id="mountainSnow" x1="720" y1="20" x2="720" y2="360" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#facc15" />
              <stop offset="45%" stop-color="#eab308" />
              <stop offset="100%" stop-color="#cbd5e1" />
            </linearGradient>
            <linearGradient id="mountainShadow" x1="500" y1="30" x2="950" y2="360" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#fef08a" />
              <stop offset="50%" stop-color="#cbd5e1" />
              <stop offset="100%" stop-color="#94a3b8" />
            </linearGradient>
          </defs>

          <!-- Main Central Mountain Mass -->
          <polygon points="180,360 660,38 745,24 1190,360" fill="url(#mountainShadow)" />
          <!-- Golden Lit Faces on Peak -->
          <polygon points="660,38 745,24 960,360 760,360 710,150 560,360 390,360" fill="url(#mountainSnow)" opacity="0.88" />
          <!-- Ridge Texture Highlights -->
          <polygon points="660,38 610,145 500,260 430,360 540,360 675,160" fill="#f8fafc" opacity="0.75" />
          <polygon points="745,24 810,120 930,270 1040,360 950,360 765,130" fill="#facc15" opacity="0.7" />

          <!-- Left & Right Technical Trajectory Lines with Arrowheads -->
          <g stroke="#ffffff" stroke-width="1.6" opacity="0.9">
            <!-- Left trajectory fan -->
            <line x1="80" y1="350" x2="500" y2="110" />
            <line x1="210" y1="360" x2="500" y2="110" />
            <line x1="310" y1="360" x2="500" y2="110" />
            <polygon points="500,110 489,115 495,122" fill="#ffffff" />

            <!-- Center peak trajectory -->
            <line x1="560" y1="360" x2="660" y2="155" />
            <polygon points="660,155 650,162 657,167" fill="#ffffff" />

            <line x1="795" y1="360" x2="778" y2="95" />
            <polygon points="778,95 773,106 783,106" fill="#ffffff" />

            <!-- Right trajectory fan -->
            <line x1="940" y1="220" x2="1015" y2="118" />
            <line x1="1040" y1="230" x2="1015" y2="118" />
            <line x1="1190" y1="240" x2="1015" y2="118" />
            <polygon points="1015,118 1012,129 1022,126" fill="#ffffff" />
          </g>
        </svg>

        <!-- Floating Interactive Cards Over the Mountain Banner (Matching Kaggle's Floating Benchmark Card) -->
        <div class="mx-auto max-w-7xl px-4 sm:px-8">
          <div class="absolute bottom-5 left-4 right-4 sm:left-8 sm:right-8 flex flex-col md:flex-row items-stretch md:items-end justify-between gap-4 pointer-events-auto">
            <!-- Left Floating Quick-Jump Pill Bar -->
            <div class="flex flex-wrap gap-2 bg-white/95 backdrop-blur rounded-2xl p-3 shadow-lg border border-neutral-200 max-w-xl">
              <button onclick="switchMainView('public')" class="rounded-xl bg-neutral-100 hover:bg-amber-100 px-3 py-2 text-left text-xs transition">
                <span class="block font-mono-eyebrow text-[10px] font-bold text-neutral-500">FLOW 01</span>
                <span class="font-bold text-neutral-900">Atomic Slot Lock (/dr-sharma)</span>
              </button>
              <button onclick="switchMainView('therapist'); switchTherapistTab('notes')" class="rounded-xl bg-neutral-100 hover:bg-amber-100 px-3 py-2 text-left text-xs transition">
                <span class="block font-mono-eyebrow text-[10px] font-bold text-neutral-500">FLOW 02</span>
                <span class="font-bold text-neutral-900">Zero-Leak SOAP/DAP Notes</span>
              </button>
              <button onclick="switchMainView('therapist'); switchTherapistTab('subscription')" class="rounded-xl bg-neutral-100 hover:bg-amber-100 px-3 py-2 text-left text-xs transition">
                <span class="block font-mono-eyebrow text-[10px] font-bold text-neutral-500">FLOW 03</span>
                <span class="font-bold text-neutral-900">Subscription Plan Admin</span>
              </button>
            </div>

            <!-- Right Floating Kaggle-Style Benchmark Card -->
            <div onclick="switchMainView('therapist')" class="cursor-pointer rounded-2xl bg-white p-5 shadow-xl border border-neutral-200 w-full md:w-80 hover:shadow-2xl transition">
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-blue-100 px-2.5 py-0.5 font-mono-eyebrow text-[11px] font-semibold text-blue-800">
                  Practice Benchmark
                </span>
                <span class="font-mono-eyebrow text-[11px] text-neutral-500">Live Sync</span>
              </div>
              <p class="mt-3 text-sm font-semibold text-neutral-900 truncate">
                Dr. Sharma Clinical OS • RCI Registered
              </p>
              <p class="mt-1 text-xs text-neutral-500">
                Click to inspect KPIs, edit subscription limits, or manage appointments →
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Architecture Pillars -->
    <section class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto">
        <p class="font-mono-eyebrow text-xs text-neutral-500 uppercase">System Architecture</p>
        <h2 class="mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900">Production-Grade Healthcare Benchmarks</h2>
        <p class="mt-2 text-xs sm:text-sm text-neutral-500">Every requirement from the master specification is wired into the interactive views above.</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm hover:border-neutral-400 transition">
          <span class="rounded-full bg-amber-100 px-2.5 py-1 font-mono-eyebrow text-xs font-semibold text-amber-900">01 • SCHEDULING</span>
          <h3 class="mt-4 text-base font-bold text-neutral-900">Concurrency-Safe Scheduling</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-neutral-600">Configurable 30/45/60/90-minute durations, buffer intervals, blocked holiday overrides, and atomic slot locking.</p>
        </div>
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm hover:border-neutral-400 transition">
          <span class="rounded-full bg-blue-100 px-2.5 py-1 font-mono-eyebrow text-xs font-semibold text-blue-900">02 • PRIVACY</span>
          <h3 class="mt-4 text-base font-bold text-neutral-900">Strict Clinical Note Isolation</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-neutral-600">SOAP, DAP, and Freeform rich-text notes. Private clinical assessments are filtered out before serialization to client views.</p>
        </div>
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm hover:border-neutral-400 transition">
          <span class="rounded-full bg-neutral-100 px-2.5 py-1 font-mono-eyebrow text-xs font-semibold text-neutral-800">03 • BILLING</span>
          <h3 class="mt-4 text-base font-bold text-neutral-900">Razorpay Test + Package Billing</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-neutral-600">Single-session checkout, 3/6/12 session discounted care bundles, platform fee net calculation, and downloadable invoices.</p>
        </div>
      </div>
    </section>

    <!-- SaaS Subscription Tiers -->
    <section class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="text-center">
        <p class="font-mono-eyebrow text-xs text-neutral-500 uppercase">Entitlements Engine</p>
        <h2 class="mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900">Configurable Subscription Tiers</h2>
        <p class="mt-1 text-xs text-neutral-500">Live-synced with your Subscription & Plan Customizer (<code class="rounded bg-neutral-100 px-1.5 py-0.5 font-mono-eyebrow">canAccess(therapistId, featureKey)</code>)</p>
      </div>

      <div id="landing-pricing-grid" class="mt-8 grid gap-6 md:grid-cols-3"></div>
    </section>
  </main>

  <!-- ===================================================================== -->
  <!-- VIEW 2: PUBLIC BRANDED BOOKING PAGE (/dr-sharma)                      -->
  <!-- ===================================================================== -->
  <main id="view-public" class="hidden flex-1 mx-auto max-w-6xl w-full px-4 py-8 sm:px-6 space-y-8">
    <!-- Practitioner Branded Hero Card -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col md:flex-row gap-6 items-start md:items-center">
        <img
          id="pub-therapist-photo"
          src="https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=400&q=80"
          onerror="this.src='https://placehold.co/160x160/0f766e/ffffff?text=Dr+Sharma'"
          alt="Dr. Ananya Sharma"
          class="h-28 w-28 rounded-3xl object-cover ring-4 ring-teal-50 shrink-0"
        />
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span id="pub-badge-slug" class="rounded-full bg-teal-50 border border-teal-200 px-3 py-1 text-xs font-bold text-teal-800">
              Verified Unfazed Practice • /dr-sharma
            </span>
            <span id="pub-languages" class="text-xs font-medium text-slate-500">
              🌐 English, Hindi, Marathi
            </span>
          </div>
          <h1 id="pub-therapist-name" class="mt-2 text-2xl sm:text-3xl font-extrabold text-slate-900">
            Dr. Ananya Sharma
          </h1>
          <p id="pub-therapist-title" class="text-xs sm:text-sm font-semibold text-teal-700">
            Senior Clinical Psychologist (M.Phil NIMHANS, RCI Licensed)
          </p>
          <p id="pub-therapist-bio" class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
            Over 9 years of clinical experience in Cognitive Behavioral Therapy (CBT), Acceptance & Commitment Therapy (ACT), and trauma-informed mindfulness for young adults and working professionals across India.
          </p>
          <div id="pub-specs-list" class="mt-3 flex flex-wrap gap-1.5"></div>
        </div>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-12">
      <!-- Left Column: Consultation Services & 3/6/12 Session Packages -->
      <div class="lg:col-span-5 space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-base font-bold text-slate-900">1. Choose Consultation Service</h2>
          <p class="text-xs text-slate-500">Select the session format and duration below.</p>
          <div id="pub-services-container" class="mt-4 space-y-3"></div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900">Multi-Session Care Packages</h2>
            <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">3, 6 & 12 Bundles</span>
          </div>
          <p class="mt-1 text-xs text-slate-500">Pre-purchase discounted bundles to redeem during booking.</p>
          <div id="pub-packages-container" class="mt-4 space-y-3"></div>
        </div>
      </div>

      <!-- Right Column: Real-Time Date & IST Slot Picker -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm space-y-6">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-base font-bold text-slate-900">2. Select Date & Available Time Slot</h2>
              <p class="text-xs text-slate-500">Times displayed in Indian Standard Time (Asia/Kolkata, IST) • Buffer: <span id="pub-buffer-display">15</span> mins</p>
            </div>
            <span class="rounded-xl bg-teal-50 px-3 py-1.5 text-xs font-bold text-teal-800">Atomic Lock Enabled</span>
          </div>

          <!-- Date Selector & Package Redemption Option -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Appointment Date</label>
              <input
                type="date"
                id="pub-date-picker"
                value="2026-10-26"
                onchange="renderPublicSlots()"
                class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-xs font-bold focus:border-teal-600 focus:outline-none"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Payment Method</label>
              <select id="pub-payment-method" class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-xs font-bold focus:border-teal-600 focus:outline-none">
                <option value="RAZORPAY_MOCK">Razorpay Test / Mock Checkout</option>
                <option value="REDEEM_PACKAGE">Redeem from Active Session Package</option>
              </select>
            </div>
          </div>

          <!-- Dynamic Slot Grid -->
          <div>
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Available IST Time Slots</label>
              <span class="text-[11px] text-slate-500">Booked slots lock immediately</span>
            </div>
            <div id="pub-slots-container" class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2.5"></div>
          </div>

          <!-- Confirmation Footer -->
          <div class="rounded-2xl bg-slate-50 p-4 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <p class="text-[11px] font-semibold uppercase text-slate-400">Booking Summary (Client: Aarav Verma)</p>
              <p id="pub-booking-summary" class="text-xs sm:text-sm font-extrabold text-slate-900 mt-0.5">
                Select an available time slot above
              </p>
            </div>
            <button
              onclick="confirmPublicAppointment()"
              class="rounded-xl bg-teal-700 px-6 py-3 text-xs font-extrabold text-white shadow-sm hover:bg-teal-800 transition shrink-0"
            >
              Confirm & Lock Slot
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- ===================================================================== -->
  <!-- VIEW 3: THERAPIST PRACTICE DASHBOARD (KAGGLE FRONTIER AESTHETIC)      -->
  <!-- ===================================================================== -->
  <main id="view-therapist" class="hidden flex-1 w-full pb-12">
    <!-- Kaggle-Style Dashboard Hero Header with Golden Mountain Graphic & Floating Benchmark Card -->
    <div class="border-b border-neutral-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 pt-8 pb-6 sm:px-8">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div>
            <p class="font-mono-eyebrow text-xs text-neutral-500">
              Unfazed is for Clinical Practitioners • <span id="th-dash-tier-badge" class="font-semibold text-neutral-900">PRO PRACTITIONER TIER</span>
            </p>
            <h1 id="th-dash-name" class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900">
              Dr. Ananya Sharma
            </h1>
            <p class="mt-2 text-xs sm:text-sm text-neutral-500">
              Evaluating clinical outcomes, appointments, and practice entitlements at
              <button onclick="switchMainView('public')" class="font-mono-eyebrow font-semibold text-neutral-900 underline hover:text-amber-700">
